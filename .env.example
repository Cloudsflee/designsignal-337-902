# Copy values into your process environment. Do not put real secrets in this file.
DESIGNSIGNAL_DATA_DIR=./data
DESIGNSIGNAL_HOST=127.0.0.1
DESIGNSIGNAL_PORT=3379
DESIGNSIGNAL_TIMEZONE=Asia/Shanghai
# Optional host source for the Compose codex_config secret.
# When empty, Compose uses ${USERPROFILE}/.codex/config.toml.
DESIGNSIGNAL_CODEX_CONFIG_FILE=
# Optional OpenAI-compatible Responses API overrides. Leave all three empty to use Codex config.
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_API_KEY=
# Optional OpenAlex request credentials/identification.
OPENALEX_API_KEY=
OPENALEX_MAILTO=
DESIGNSIGNAL_MODEL_CONCURRENCY=2
DESIGNSIGNAL_MODEL_TIMEOUT_MS=180000
DESIGNSIGNAL_MODEL_MAX_OUTPUT_TOKENS=6000
# Optional host source used only with compose.study-profile.yaml. Leave empty by default.
DESIGNSIGNAL_STUDY_PROFILE_HOST_FILE=
# Feishu tenant app document delivery. Keep credentials outside Git.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_DOC_FOLDER_TOKEN=
# Optional HTTPS tenant document-link origin (never used for API calls).
FEISHU_TENANT_BASE_URL=https://feishu.cn
# Optional comma-separated RSSHub feed URLs; only allowlisted public hosts are accepted.
DESIGNSIGNAL_RSSHUB_FEEDS=
DESIGNSIGNAL_RSSHUB_WECHAT_FEEDS=
DESIGNSIGNAL_RSSHUB_ZHIHU_FEEDS=
