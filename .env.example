# Copy values into your process environment. Do not put real secrets in this file.
DESIGNSIGNAL_DATA_DIR=./data
DESIGNSIGNAL_HOST=127.0.0.1
DESIGNSIGNAL_PORT=3379
DESIGNSIGNAL_TIMEZONE=Asia/Shanghai
# Optional OpenAI-compatible Responses API
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_API_KEY=
# Optional push endpoints/secrets
DESIGNSIGNAL_WEBHOOK_URL=
FEISHU_WEBHOOK_URL=
WECOM_WEBHOOK_URL=
# Optional comma-separated RSSHub feed URLs; only allowlisted public hosts are accepted.
DESIGNSIGNAL_RSSHUB_FEEDS=
